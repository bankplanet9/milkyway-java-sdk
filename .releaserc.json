{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "mvn -B versions:set -DnewVersion=${nextRelease.version} -DgenerateBackupPoms=false && mvn -B -DskipTests package"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          { "path": "target/*.jar", "label": "JAR (built from source)" }
        ]
      }
    ]
  ]
}
